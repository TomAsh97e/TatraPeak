file(MAKE_DIRECTORY "${TEST_DIR}")

function(run_expect expected)
    execute_process(COMMAND "${TATRA_EXE}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${output} ${error}")
    endif()
endfunction()

run_expect(0 render --dataset synthetic --scene "${SCENE}" --out "${TEST_DIR}/success")
file(READ "${TEST_DIR}/success/result.json" result)
file(READ "${TEST_DIR}/success/overlay.svg" overlay)
string(JSON version GET "${result}" schema_version)
string(JSON count LENGTH "${result}" observations)
string(JSON warning GET "${result}" warnings 0 code)
if(NOT version EQUAL 1 OR NOT count EQUAL 5 OR NOT warning STREQUAL "MissingTerrain")
    message(FATAL_ERROR "Unexpected synthetic scene output: ${result}")
endif()
set(expected_ids test:behind test:missing test:occluded test:outside test:visible)
set(expected_projections BehindNearPlane InFrame InFrame OutsideFrame InFrame)
foreach(index RANGE 0 4)
    list(GET expected_ids ${index} expected_id)
    list(GET expected_projections ${index} expected_projection)
    string(JSON id GET "${result}" observations ${index} id)
    string(JSON projection GET "${result}" observations ${index} projection state)
    if(NOT id STREQUAL expected_id OR NOT projection STREQUAL expected_projection)
        message(FATAL_ERROR "Unexpected observation ${index}")
    endif()
endforeach()
foreach(pair "1;MissingTerrain" "2;OccludedInModel" "4;VisibleInModel")
    list(GET pair 0 index)
    list(GET pair 1 expected)
    string(JSON state GET "${result}" observations ${index} visibility state)
    if(NOT state STREQUAL expected)
        message(FATAL_ERROR "Unexpected visibility: ${state}")
    endif()
endforeach()
if(NOT overlay MATCHES "viewBox=\"0 0 1280 720\"")
    message(FATAL_ERROR "SVG does not use the camera coordinate system")
endif()
if(NOT overlay MATCHES "data-peak-id=\"test:visible\"" OR
   NOT overlay MATCHES "data-peak-id=\"test:missing\"" OR
   overlay MATCHES "data-peak-id=\"test:occluded\"")
    message(FATAL_ERROR "Unexpected peaks in the default SVG overlay")
endif()

run_expect(3 render --dataset synthetic --scene "${TEST_DIR}/absent.json" --out "${TEST_DIR}/missing")
file(WRITE "${TEST_DIR}/invalid.json" "{not JSON")
run_expect(2 render --dataset synthetic --scene "${TEST_DIR}/invalid.json" --out "${TEST_DIR}/invalid")
file(WRITE "${TEST_DIR}/blocked" "regular file, not a directory")
run_expect(3 render --dataset synthetic --scene "${SCENE}" --out "${TEST_DIR}/blocked")
run_expect(2 render --dataset real-data --scene "${SCENE}" --out "${TEST_DIR}/unsupported")
run_expect(2 render --dataset synthetic --scene "${SCENE}")
run_expect(2 render --dataset synthetic --scene "${SCENE}" --out "${TEST_DIR}/duplicate" --scene "${SCENE}")
