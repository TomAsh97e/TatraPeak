run_render(south-east debug --debug-peak osm:node:26862937 --debug-peak osm:node:1862536196)
file(READ "${TEST_DIR}/debug/visibility-debug.json" debug)
string(JSON debug_hash GET "${debug}" metadata dataset_sha256)
string(JSON expected_hash GET "${south-east_result}" metadata dataset_sha256)
string(JSON trace_count LENGTH "${debug}" traces)
if(NOT debug_hash STREQUAL expected_hash OR NOT trace_count EQUAL 2)
    message(FATAL_ERROR "Debug trace metadata does not match render metadata")
endif()
set(found_seam FALSE)
math(EXPR last_trace "${trace_count} - 1")
foreach(trace_index RANGE 0 ${last_trace})
    string(JSON declared_count GET "${debug}" traces ${trace_index} result sample_count)
    string(JSON sample_count LENGTH "${debug}" traces ${trace_index} samples)
    if(NOT declared_count EQUAL sample_count OR sample_count EQUAL 0)
        message(FATAL_ERROR "Incomplete debug trace ${trace_index}")
    endif()
    math(EXPR last_sample "${sample_count} - 1")
    foreach(sample_index RANGE 0 ${last_sample})
        string(JSON terrain_state GET "${debug}" traces ${trace_index} samples ${sample_index} terrain_state)
        string(JSON longitude GET "${debug}" traces ${trace_index} samples ${sample_index} ray_position longitude_deg)
        if(NOT terrain_state STREQUAL "Valid")
            message(FATAL_ERROR "Invalid terrain at the source-tile seam")
        endif()
        if(longitude GREATER_EQUAL 19.9998 AND longitude LESS_EQUAL 20.0002)
            set(found_seam TRUE)
        endif()
    endforeach()
endforeach()
if(NOT found_seam)
    message(FATAL_ERROR "Debug traces did not cross the longitude 20 source-tile seam")
endif()

run_render(outside-coverage outside-coverage)
file(READ "${TEST_DIR}/outside-coverage/result.json" outside)
string(JSON observation_count LENGTH "${outside}" observations)
math(EXPR last_observation "${observation_count} - 1")
set(missing_count 0)
foreach(index RANGE 0 ${last_observation})
    string(JSON visibility_type TYPE "${outside}" observations ${index} visibility)
    if(NOT visibility_type STREQUAL "NULL")
        string(JSON state GET "${outside}" observations ${index} visibility state)
        if(state STREQUAL "VisibleInModel")
            message(FATAL_ERROR "Outside-coverage observation became VisibleInModel")
        endif()
        if(state STREQUAL "MissingTerrain")
            math(EXPR missing_count "${missing_count} + 1")
        endif()
    endif()
endforeach()
if(missing_count EQUAL 0)
    message(FATAL_ERROR "Outside-coverage scene did not report MissingTerrain")
endif()
