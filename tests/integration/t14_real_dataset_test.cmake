observation_value("${south-west_result}" "Wielki Giewont" "projection;state" sw_giewont)
if(east_kiezmarski STREQUAL "InFrame" OR NOT se_kiezmarski STREQUAL "InFrame" OR
   south_giewont STREQUAL "InFrame" OR NOT sw_giewont STREQUAL "InFrame")
    message(FATAL_ERROR "Peak sector assignment is inconsistent with the selected headings")
