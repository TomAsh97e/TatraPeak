foreach(required TATRA_EXE DATASET SCENE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing -D${required}=...")
    endif()
endforeach()

file(MAKE_DIRECTORY "${TEST_DIR}")

function(run_render scene output)
    execute_process(
        COMMAND "${TATRA_EXE}" render --dataset "${DATASET}"
            --scene "${SCENE_DIR}/${scene}.json" --out "${TEST_DIR}/${output}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Render ${scene} failed (${status}): ${stdout} ${stderr}")
    endif()
endfunction()

function(read_result view output)
    file(READ "${TEST_DIR}/${view}/result.json" result)
    string(JSON dataset_id GET "${result}" metadata dataset_id)
    string(JSON dataset_hash GET "${result}" metadata dataset_sha256)
    string(JSON simulated GET "${result}" metadata observer_simulated)
    string(LENGTH "${dataset_hash}" hash_length)
    if(NOT dataset_id STREQUAL "tatras-v1" OR NOT hash_length EQUAL 64 OR NOT simulated)
        message(FATAL_ERROR "Missing T14 metadata in ${view}: ${result}")
    endif()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(observation_value result name pointer output)
    string(JSON count LENGTH "${result}" observations)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON candidate GET "${result}" observations ${index} name)
        if(candidate STREQUAL name)
            string(JSON value GET "${result}" observations ${index} ${pointer})
            set(${output} "${value}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Observation '${name}' is absent")
endfunction()

foreach(view east south-east south south-west)
    run_render(${view} ${view})
    read_result(${view} ${view}_result)
endforeach()

observation_value("${south-east_result}" "Kościelec" "projection;pixel;u" koscielec_se_u)
